{
  "schema_version": "1.0",
  "registry_id": "acd-firmware-capabilities-14.14",
  "pin_role_order": [
    "led",
    "led2",
    "button",
    "i2c_sda",
    "i2c_scl",
    "uart_tx",
    "uart_rx",
    "boot",
    "usb_dn",
    "usb_dp"
  ],
  "capabilities": [
    {
      "capability_id": "firmware_init",
      "actions": ["initialize_firmware"],
      "required_pin_roles": [],
      "emits_triggers": ["boot_complete", "gpio_configure_failed"],
      "requires_device": false
    },
    {
      "capability_id": "led_blink",
      "actions": ["toggle_led"],
      "required_pin_roles": ["led"],
      "emits_triggers": [],
      "requires_device": false
    },
    {
      "capability_id": "led2_blink",
      "actions": ["toggle_led2"],
      "required_pin_roles": ["led2"],
      "emits_triggers": [],
      "requires_device": false,
      "description": "Second LED toggled in antiphase to the led pin."
    },
    {
      "capability_id": "button_input",
      "actions": ["read_button"],
      "required_pin_roles": ["button"],
      "emits_triggers": ["button_pressed"],
      "requires_device": false,
      "description": "Active-low momentary input with internal pull-up."
    },
    {
      "capability_id": "i2c_sensor_init",
      "actions": ["initialize_sht40"],
      "required_pin_roles": ["i2c_sda", "i2c_scl"],
      "emits_triggers": ["sensor_init_complete", "sensor_init_failed"],
      "requires_device": true
    },
    {
      "capability_id": "i2c_sensor_read",
      "actions": ["read_temperature_humidity"],
      "required_pin_roles": ["i2c_sda", "i2c_scl"],
      "emits_triggers": ["measurement_ready", "sensor_read_failed"],
      "requires_device": true
    },
    {
      "capability_id": "serial_log",
      "actions": ["write_serial_log"],
      "required_pin_roles": [],
      "emits_triggers": ["report_complete"],
      "requires_device": false
    }
  ],
  "devices": [
    {
      "mpn": "SHT40-AD1B-R3",
      "driver_id": "sht40",
      "i2c_address": 68,
      "measurement_command": 253,
      "source_url": "https://sensirion.com/media/documents/33FD6951/6A7C10A0/HT_DS_Datasheet_SHT4x_V7.3.pdf",
      "source_ref": "Sensirion SHT4x Datasheet V7.3, Section 1 Quick Start Guide"
    }
  ]
}
