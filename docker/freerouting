#!/bin/sh

# The SCC is generated at image build time and reused read-only at runtime.
# A missing cache is a startup failure by design.
FREEROUTING_MAX_HEAP="${FREEROUTING_MAX_HEAP:-2g}"
FREEROUTING_JVM_TUNING="${FREEROUTING_JVM_TUNING:--Xtune:footprint}"
FREEROUTING_SCC_NAME="${FREEROUTING_SCC_NAME:-fr_scc}"
FREEROUTING_SCC_DIR="${FREEROUTING_SCC_DIR:-/opt/scc}"
FREEROUTING_CONTAINER_SUPPORT="-XX:+UseContainerSupport"
FREEROUTING_ADAPTIVE_GC_THREADING="-XX:+AdaptiveGCThreading"

if [ "${FREEROUTING_ACTIVE_PROCESSORS+x}" = x ]; then
  # JVM tuning intentionally uses word splitting for multiple options.
  # shellcheck disable=SC2086
  exec java \
    "-Xmx${FREEROUTING_MAX_HEAP}" \
    ${FREEROUTING_JVM_TUNING} \
    "-Djava.awt.headless=true" \
    "-Xshareclasses:name=${FREEROUTING_SCC_NAME},cacheDir=${FREEROUTING_SCC_DIR},readonly" \
    "${FREEROUTING_CONTAINER_SUPPORT}" \
    "${FREEROUTING_ADAPTIVE_GC_THREADING}" \
    "-XX:ActiveProcessorCount=${FREEROUTING_ACTIVE_PROCESSORS}" \
    -jar /opt/freerouting.jar \
    "$@"
fi

# JVM tuning intentionally uses word splitting for multiple options.
# shellcheck disable=SC2086
exec java \
  "-Xmx${FREEROUTING_MAX_HEAP}" \
  ${FREEROUTING_JVM_TUNING} \
  "-Djava.awt.headless=true" \
  "-Xshareclasses:name=${FREEROUTING_SCC_NAME},cacheDir=${FREEROUTING_SCC_DIR},readonly" \
  "${FREEROUTING_CONTAINER_SUPPORT}" \
  "${FREEROUTING_ADAPTIVE_GC_THREADING}" \
  -jar /opt/freerouting.jar \
  "$@"
