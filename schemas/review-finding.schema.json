{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acd.example/schemas/review-finding.schema.json",
  "title": "ACD review finding",
  "description": "AI review finding on a projection. Review has no pass/fail authority; undisposed high-severity findings block pass verdicts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "review_view",
    "severity",
    "target_revision",
    "projection",
    "description",
    "disposition"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "finding_id": {"type": "string", "minLength": 1},
    "review_view": {
      "type": "string",
      "enum": ["RV1", "RV2"]
    },
    "severity": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "target_revision": {"$ref": "common.schema.json#/$defs/revision"},
    "projection": {"$ref": "#/$defs/projectionRef"},
    "description": {"type": "string", "minLength": 1},
    "disposition": {
      "type": "string",
      "enum": ["open", "fixed", "waived", "assumption", "rejected"]
    },
    "disposition_reason": {"type": "string"},
    "disposed_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "$defs": {
    "projectionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_kind", "content_hash", "generated_at", "source_revision"],
      "properties": {
        "projection_kind": {
          "type": "string",
          "enum": ["machine_readable", "visual"]
        },
        "content_hash": {"$ref": "common.schema.json#/$defs/hashOrUnknown"},
        "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "source_revision": {"$ref": "common.schema.json#/$defs/revision"}
      }
    }
  }
}
