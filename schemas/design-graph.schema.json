{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acd.example/schemas/design-graph.schema.json",
  "title": "ACD design graph",
  "description": "Canonical typed, versioned design graph. Projections are derived from it and never merged back.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "revision", "nodes"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "graph_id": {"type": "string", "minLength": 1},
    "revision": {"$ref": "common.schema.json#/$defs/revision"},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/nodeId"},
        "kind": {
          "type": "string",
          "enum": [
            "requirement",
            "electrical.net",
            "electrical.component",
            "electrical.pin",
            "firmware.module",
            "firmware.pin_assignment",
            "safety.boundary",
            "evidence.anchor"
          ]
        },
        "attrs": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        },
        "depends_on": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/nodeId"},
          "uniqueItems": true
        }
      }
    }
  }
}
