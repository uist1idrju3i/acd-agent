{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acd.example/schemas/dfm-report.schema.json",
  "title": "ACD DFM report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_revision", "profile_id", "status", "findings", "checks_not_implemented", "measurements", "unknowns"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "target_revision": {"$ref": "common.schema.json#/$defs/revision"},
    "profile_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "fail", "unknown"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "checks_not_implemented": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["rule_id", "reason"], "properties": {"rule_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}},
    "measurements": {"type": "object", "additionalProperties": true},
    "unknowns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpl_rotation_basis_fab_lcsc"],
      "properties": {
        "cpl_rotation_basis_fab_lcsc": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "classification", "measured_value", "threshold", "unit", "locations", "allowance", "status"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "classification": {"enum": ["capability_violation", "cost_or_lead_time_adder", "quality_risk", "unused_allowance"]},
        "measured_value": {},
        "threshold": {},
        "unit": {"type": "string", "minLength": 1},
        "locations": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "allowance": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/allowance"}]},
        "status": {"enum": ["fail", "allowed"]}
      }
    },
    "allowance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "reason", "requirement"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "requirement": {"type": "string", "minLength": 1}
      }
    }
  }
}
