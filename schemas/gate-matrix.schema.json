{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acd.example/schemas/gate-matrix.schema.json",
  "title": "ACD gate matrix",
  "description": "Deterministic gate results for one design-graph revision. Only status \"pass\" counts as pass; stale/unknown/not_run are failures for verdict purposes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_revision", "gates"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "target_revision": {"$ref": "common.schema.json#/$defs/revision"},
    "gates": {
      "type": "array",
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "kind", "status", "evidence_refs"],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "enum": [
            "erc",
            "drc",
            "dfm",
            "fw_build",
            "fw_static_analysis",
            "fw_unit_test",
            "pin_net_consistency",
            "review_disposition",
            "safety_boundary"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "stale", "not_run", "unknown"]
        },
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "waiver": {"$ref": "#/$defs/waiver"}
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "reason", "target_revision", "expires_at"],
      "properties": {
        "waiver_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "target_revision": {"$ref": "common.schema.json#/$defs/revision"},
        "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    }
  }
}
