{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acd.local/schemas/library-overlay.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "overlay_id",
    "target",
    "source_footprint_file",
    "source_footprint_sha256",
    "ops",
    "reason",
    "evidence"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "overlay_id": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library", "footprint"],
      "properties": {
        "library": {"type": "string", "minLength": 1},
        "footprint": {"type": "string", "minLength": 1}
      }
    },
    "source_footprint_file": {"type": "string", "minLength": 1},
    "source_footprint_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "pad_number", "target_annular_ring_mm"],
        "properties": {
          "op": {"type": "string", "const": "grow_pad_annular_ring"},
          "pad_number": {"type": "string", "minLength": 1},
          "target_annular_ring_mm": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "reason": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fab_profile", "rule_id", "url", "fetched_at"],
      "properties": {
        "fab_profile": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "const": "pth-annular-ring-prefer-025"},
        "url": {"type": "string", "format": "uri"},
        "fetched_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
