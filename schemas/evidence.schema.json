{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acd.example/schemas/evidence.schema.json",
  "title": "ACD evidence record",
  "description": "Verification evidence bound to a design-graph revision. Raw tool stdout alone is never evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "target_revision",
    "status",
    "envelope",
    "claims",
    "created_at"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "evidence_id": {"type": "string", "minLength": 1},
    "target_revision": {"$ref": "common.schema.json#/$defs/revision"},
    "status": {
      "type": "string",
      "enum": ["valid", "stale", "invalidated", "unknown"]
    },
    "envelope": {"$ref": "tool-envelope.schema.json"},
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_node", "property", "value", "verified"],
      "properties": {
        "subject_node": {"$ref": "common.schema.json#/$defs/nodeId"},
        "property": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "boolean"]},
        "verified": {
          "type": "boolean",
          "description": "False means the claim is observed but not verified; it must not support a pass verdict."
        }
      }
    }
  }
}
