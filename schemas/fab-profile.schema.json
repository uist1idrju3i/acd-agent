{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acd.example/schemas/fab-profile.schema.json",
  "title": "ACD fab profile",
  "description": "Versioned declarative manufacturing capability and preference data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "fab", "process", "sources", "capabilities", "preferences", "unsupported", "assembly_classes"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
    "fab": {"type": "string", "minLength": 1},
    "process": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "fetched_at", "title"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "fetched_at": {"$ref": "common.schema.json#/$defs/timestamp"},
          "title": {"type": "string", "minLength": 1}
        }
      }
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/measurement"}
    },
    "preferences": {
      "type": "array",
      "items": {"$ref": "#/$defs/preference"}
    },
    "unsupported": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "assembly_classes": {
      "type": "object",
      "required": ["economic", "standard"],
      "additionalProperties": false,
      "properties": {
        "economic": {"$ref": "#/$defs/assemblyClass"},
        "standard": {"$ref": "#/$defs/assemblyClass"}
      }
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "source_index", "basis", "note"],
      "properties": {
        "value": {"type": ["number", "string", "array", "object"]},
        "unit": {"type": "string", "minLength": 1},
        "source_index": {"type": "integer", "minimum": 0},
        "basis": {"enum": ["primary", "inference"]},
        "note": {"type": "string"}
      }
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "description", "impact", "source_index", "basis", "note"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
        "description": {"type": "string", "minLength": 1},
        "impact": {
          "oneOf": [
            {"enum": ["cost", "lead_time", "quality"]},
            {"type": "array", "items": {"enum": ["cost", "lead_time", "quality"]}, "minItems": 1, "uniqueItems": true}
          ]
        },
        "source_index": {"type": "integer", "minimum": 0},
        "basis": {"enum": ["primary", "inference"]},
        "note": {"type": "string"}
      }
    },
    "assemblyClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assembly_sides", "layers", "thickness_mm", "board_size_mm", "panel_size_mm", "quantity_pcs", "min_package", "min_ic_pitch_mm", "min_bga_pitch_mm", "edge_rails_required", "fiducials_required", "build_time_days", "combinations"],
      "properties": {
        "assembly_sides": {"type": "array", "items": {"enum": ["top", "bottom", "both"]}, "minItems": 1, "uniqueItems": true},
        "layers": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1},
        "thickness_mm": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 1},
        "board_size_mm": {"type": "object", "required": ["min", "max"], "additionalProperties": false, "properties": {"min": {"$ref": "#/$defs/range2"}, "max": {"$ref": "#/$defs/range2"}}},
        "panel_size_mm": {"type": "object", "required": ["min", "max"], "additionalProperties": false, "properties": {"min": {"$ref": "#/$defs/range2"}, "max": {"$ref": "#/$defs/range2"}}},
        "quantity_pcs": {"$ref": "#/$defs/range1"},
        "min_package": {"type": "string", "minLength": 1},
        "min_ic_pitch_mm": {"type": "number", "exclusiveMinimum": 0},
        "min_bga_pitch_mm": {"type": "number", "exclusiveMinimum": 0},
        "edge_rails_required": {"type": "boolean"},
        "fiducials_required": {"type": "boolean"},
        "build_time_days": {"$ref": "#/$defs/range1"},
        "combinations": {"type": "array", "items": {"type": "object"}}
      }
    },
    "range1": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": {"min": {"type": "number"}, "max": {"type": "number"}}
    },
    "range2": {
      "type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}],
      "minItems": 2, "maxItems": 2
    }
  }
}
