{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acd.example/schemas/tool-envelope.schema.json",
  "title": "ACD external tool execution envelope",
  "description": "Record of a single external tool execution. Any unknown field keeps the result out of pass verdicts (fail-closed).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_name",
    "tool_version",
    "format_version",
    "config_hash",
    "input_hash",
    "output_hash",
    "execution_env",
    "measurement_conditions",
    "convergence_state",
    "target_revision",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "tool_name": {"type": "string", "minLength": 1},
    "tool_version": {"$ref": "common.schema.json#/$defs/versionOrUnknown"},
    "format_version": {"$ref": "common.schema.json#/$defs/versionOrUnknown"},
    "config_hash": {"$ref": "common.schema.json#/$defs/hashOrUnknown"},
    "input_hash": {"$ref": "common.schema.json#/$defs/hashOrUnknown"},
    "output_hash": {"$ref": "common.schema.json#/$defs/hashOrUnknown"},
    "execution_env": {"type": "string", "minLength": 1},
    "measurement_conditions": {"type": "string", "minLength": 1},
    "convergence_state": {
      "type": "string",
      "enum": ["converged", "not_converged", "not_applicable", "unknown"]
    },
    "target_revision": {"$ref": "common.schema.json#/$defs/revision"},
    "started_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "finished_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "exit_code": {"type": ["integer", "null"]},
    "idempotency_key": {"$ref": "common.schema.json#/$defs/idempotencyKey"},
    "uncertainty": {"type": "string"}
  }
}
