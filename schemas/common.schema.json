{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acd.example/schemas/common.schema.json",
  "title": "ACD common definitions",
  "description": "Shared definitions for ACD contracts. Unknown values are explicit and fail-closed.",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Contract version of the document itself."
    },
    "revision": {
      "type": "string",
      "pattern": "^r[0-9]+$",
      "description": "Design-graph revision identifier."
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Content hash with explicit algorithm prefix."
    },
    "hashOrUnknown": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"const": "unknown"}
      ],
      "description": "A hash that is either verified or explicitly unknown (fail-closed)."
    },
    "versionOrUnknown": {
      "oneOf": [
        {"type": "string", "minLength": 1, "not": {"const": "unknown"}},
        {"const": "unknown"}
      ],
      "description": "A tool/format version string or explicitly unknown."
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "description": "Design-graph node identifier."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp."
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "description": "Idempotency key for side-effecting operations."
    }
  }
}
