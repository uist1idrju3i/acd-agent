{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acd.example/schemas/error-taxonomy.schema.json",
  "title": "ACD structured error",
  "description": "Structured error record used across ACD tools and gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "code", "category", "severity", "message", "retriable"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "code": {
      "type": "string",
      "pattern": "^ACD-E[0-9]{3}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "input_unknown",
        "version_unknown",
        "hash_mismatch",
        "revision_mismatch",
        "stale",
        "not_converged",
        "invalid_output",
        "tool_missing",
        "external_service",
        "safety_boundary",
        "budget",
        "license",
        "irreversible_operation",
        "internal"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["fatal", "error", "warning", "info"]
    },
    "message": {"type": "string", "minLength": 1},
    "retriable": {"type": "boolean"},
    "source_tool": {"type": "string"},
    "target_revision": {"$ref": "common.schema.json#/$defs/revision"}
  }
}
