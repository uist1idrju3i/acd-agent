+#!/usr/bin/env python3
+"""Build graph without rationale validation to inspect the result."""
+
+import json
+from pathlib import Path
+
+from acd.core import rationale as rationale_module
+from acd.pipeline.fixture_builder import build_design_fixture
+from acd.schema import DesignFixtureSpec
+
+original_check = rationale_module.check_rationale_coverage
+
+def noop_check(graph, document):
+    class FakeReport:
+        status = "pass"
+        graph_id = graph.graph_id
+        revision = graph.revision
+        graph_id_match = True
+        revision_match = True
+        missing = []
+        stale = []
+        unknown_provenance = []
+        orphan = []
+        untraceable = []
+        conflicting = []
+        unclassified = []
+        templated = []
+        generator_violations = []
+        required_count = 0
+        covered_count = 0
+        record_count = 0
+    return FakeReport()
+
+rationale_module.check_rationale_coverage = noop_check
+
+try:
+    spec_path = Path("fixtures/dual-beacon-tag/spec.json")
+    spec = DesignFixtureSpec.model_validate_json(spec_path.read_text(encoding="utf-8"))
+    graph = build_design_fixture(spec, Path("fixtures/dual-beacon-tag"), overwrite=True, spec_dir=spec_path.parent)
+    print("Graph built successfully!")
+    print(f"Graph ID: {graph.graph_id}")
+    print(f"Nodes: {len(graph.nodes)}")
+    
+    # Now run the real check to see what's wrong
+    report = original_check(graph, rationale_module.RationaleDocument(graph_id=graph.graph_id, revision=graph.revision, records=[]))
+    print(f"\nReal check status: {report.status}")
+    if report.missing:
+        print(f"Missing: {report.missing}")
+    if report.stale:
+        print(f"Stale: {report.stale}")
+    if report.unclassified:
+        print(f"Unclassified ({len(report.unclassified)}):")
+        for u in report.unclassified[:20]:
+            print(f"  {u.node_kind}/{u.node_id}: {u.attr}")
+    if report.orphan:
+        print(f"Orphan: {report.orphan[:10]}")
+    if report.untraceable:
+        print(f"Untraceable: {report.untraceable[:10]}")
+    if report.unknown_provenance:
+        print(f"Unknown provenance: {report.unknown_provenance[:10]}")
+    if report.conflicting:
+        print(f"Conflicting: {report.conflicting[:10]}")
+        
+finally:
+    rationale_module.check_rationale_coverage = original_check
diff --git a/debug_build_in_container.py b/debug_build_in_container.py
new file mode 100644
index 0000000..97bfd3f
--- /dev/null
+++ b/debug_build_in_container.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+"""Build graph in container without rationale validation."""
+
+import json
+import sys
+from pathlib import Path
+
+# Monkeypatch BEFORE importing fixture_builder
+from acd.core import rationale as rationale_module
+from acd.pipeline.fixture_builder import build_design_fixture
+from acd.schema import DesignFixtureSpec
+
+_original_check = rationale_module.check_rationale_coverage
+
+class FakeReport:
+    def __init__(self, graph, document):
+        self.status = "pass"
+        self.graph_id = graph.graph_id
+        self.revision = graph.revision
+        self.graph_id_match = True
+        self.revision_match = True
+        self.missing = []
+        self.stale = []
+        self.unknown_provenance = []
+        self.orphan = []
+        self.untraceable = []
+        self.conflicting = []
+        self.unclassified = []
+        self.templated = []
+        self.generator_violations = []
+        self.required_count = 0
+        self.covered_count = 0
+        self.record_count = 0
+
+def noop_check(graph, document):
+    return FakeReport(graph, document)
+
+rationale_module.check_rationale_coverage = noop_check
+
+out_dir = Path("out/dual-beacon-tag/debug")
+out_dir.mkdir(parents=True, exist_ok=True)
+
+try:
+    spec_path = Path("fixtures/dual-beacon-tag/spec.json")
+    spec = DesignFixtureSpec.model_validate_json(spec_path.read_text(encoding="utf-8"))
+    graph = build_design_fixture(spec, out_dir, overwrite=True, spec_dir=spec_path.parent)
+    print("Graph built successfully!")
+    print(f"Graph ID: {graph.graph_id}")
+    print(f"Nodes: {len(graph.nodes)}")
+    
+    # Run real check to see issues
+    report = _original_check(graph, rationale_module.RationaleDocument(
+        graph_id=graph.graph_id, revision=graph.revision, records=[]
+    ))
+    result = {
+        "status": report.status,
+        "missing": [str(m) for m in report.missing],
+        "stale": [str(s) for s in report.stale],
+        "unclassified": [
+            {"node_kind": u.node_kind, "node_id": u.node_id, "attr": u.attr}
+            for u in report.unclassified
+        ],
+        "orphan": [str(o) for o in report.orphan],
+        "untraceable": [str(u) for u in report.untraceable],
+        "unknown_provenance": [str(u) for u in report.unknown_provenance],
+        "conflicting": [str(c) for c in report.conflicting],
+        "templated": [str(t) for t in report.templated],
+        "generator_violations": [str(g) for g in report.generator_violations],
+    }
+    (out_dir / "rationale_report.json").write_text(
+        json.dumps(result, indent=2, ensure_ascii=False), encoding="utf-8"
+    )
+    print(f"Rationale check status: {report.status}")
+    if report.unclassified:
+        print(f"Unclassified ({len(report.unclassified)}):")
+        for u in report.unclassified[:30]:
+            print(f"  {u.node_kind}/{u.node_id}: {u.attr}")
+    if report.missing:
+        print(f"Missing ({len(report.missing)}):")
+        for m in report.missing[:10]:
+            print(f"  {m}")
+    if report.orphan:
+        print(f"Orphan ({len(report.orphan)}):")
+        for o in report.orphan[:10]:
+            print(f"  {o}")
+    if report.untraceable:
+        print(f"Untraceable ({len(report.untraceable)}):")
+        for u in report.untraceable[:10]:
+            print(f"  {u}")
+    print(f"\nGraph saved to: {out_dir / 'graph.json'}")
+    
+except Exception as exc:
+    import traceback
+    traceback.print_exc()
+    sys.exit(2)
+finally:
+    rationale_module.check_rationale_coverage = _original_check
