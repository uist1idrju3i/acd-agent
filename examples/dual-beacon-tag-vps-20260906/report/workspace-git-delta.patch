new file mode 100644
index 0000000..7888ac0
--- /dev/null
+++ b/run_container_debug.py
@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+"""Execute debug build in container by passing script via stdin."""
+import subprocess
+import sys
+
+script = '''
+import json, sys
+from pathlib import Path
+from acd.core import rationale as rationale_module
+import acd.pipeline.fixture_builder as fb_module
+from acd.schema import DesignFixtureSpec
+
+_original_check = fb_module.check_rationale_coverage
+
+class FakeReport:
+    def __init__(self, graph, document):
+        self.status = "pass"
+        self.graph_id = graph.graph_id
+        self.revision = graph.revision
+        self.graph_id_match = True
+        self.revision_match = True
+        self.missing = []
+        self.stale = []
+        self.unknown_provenance = []
+        self.orphan = []
+        self.untraceable = []
+        self.conflicting = []
+        self.unclassified = []
+        self.templated = []
+        self.generator_violations = []
+        self.required_count = 0
+        self.covered_count = 0
+        self.record_count = 0
+
+def noop_check(graph, document):
+    return FakeReport(graph, document)
+
+fb_module.check_rationale_coverage = noop_check
+
+out_dir = Path("out/dual-beacon-tag/debug")
+out_dir.mkdir(parents=True, exist_ok=True)
+
+try:
+    spec_path = Path("fixtures/dual-beacon-tag/spec.json")
+    spec = DesignFixtureSpec.model_validate_json(spec_path.read_text(encoding="utf-8"))
+    graph = fb_module.build_design_fixture(spec, out_dir, overwrite=True, spec_dir=spec_path.parent)
+    print("Graph built successfully!")
+    print(f"Graph ID: {graph.graph_id}")
+    print(f"Nodes: {len(graph.nodes)}")
+    
+    report = _original_check(graph, rationale_module.RationaleDocument(
+        graph_id=graph.graph_id, revision=graph.revision, records=[]
+    ))
+    result = {
+        "status": report.status,
+        "missing": [str(m) for m in report.missing],
+        "stale": [str(s) for s in report.stale],
+        "unclassified": [
+            {"node_kind": u.node_kind, "node_id": u.node_id, "attr": u.attr}
+            for u in report.unclassified
+        ],
+        "orphan": [str(o) for o in report.orphan],
+        "untraceable": [str(u) for u in report.untraceable],
+        "unknown_provenance": [str(u) for u in report.unknown_provenance],
+        "conflicting": [str(c) for c in report.conflicting],
+        "templated": [str(t) for t in report.templated],
+        "generator_violations": [str(g) for g in report.generator_violations],
+    }
+    (out_dir / "rationale_report.json").write_text(
+        json.dumps(result, indent=2, ensure_ascii=False), encoding="utf-8"
+    )
+    print(f"Rationale check status: {report.status}")
+    if report.unclassified:
+        print(f"Unclassified ({len(report.unclassified)}):")
+        for u in report.unclassified[:50]:
+            print(f"  {u.node_kind}/{u.node_id}: {u.attr}")
+    if report.missing:
+        print(f"Missing ({len(report.missing)}):")
+        for m in report.missing[:10]:
+            print(f"  {m}")
+    if report.orphan:
+        print(f"Orphan ({len(report.orphan)}):")
+        for o in report.orphan[:10]:
+            print(f"  {o}")
+    if report.untraceable:
+        print(f"Untraceable ({len(report.untraceable)}):")
+        for u in report.untraceable[:10]:
+            print(f"  {u}")
+    print(f"Graph saved to: {out_dir / 'graph.json'}")
+except Exception as exc:
+    import traceback
+    traceback.print_exc()
+    sys.exit(2)
+finally:
+    fb_module.check_rationale_coverage = _original_check
+'''
+
+print("Script prepared, length:", len(script))
